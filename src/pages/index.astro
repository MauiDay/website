---
import Layout from '../layouts/Layout.astro';
import { config } from '../../mauiday.config.mjs';

const socialLinks = [
  { name: 'Bluesky', href: config.BLUESKY_LINK, icon: 'fa-bluesky' },
  { name: 'X', href: config.X_LINK, icon: 'fa-x-twitter' },
  { name: 'GitHub', href: config.GITHUB_LINK, icon: 'fa-github' },
  { name: 'LinkedIn', href: config.LINKEDIN_LINK, icon: 'fa-linkedin' },
  { name: 'Flickr', href: config.FLICKR_LINK, icon: 'fa-flickr' },
  { name: 'Instagram', href: config.INSTAGRAM_LINK, icon: 'fa-instagram' },
];
---

<Layout>
  <section class="relative flex min-h-screen items-center justify-center bg-cover bg-center hero px-6 py-32">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_transparent_15%,_#0b1d51cc_100%)]"></div>

    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <p class="mb-5 text-sm font-bold uppercase tracking-[0.25em] text-pink-300">Until next time</p>
      <h1 class="mb-6 font-header text-4xl font-bold uppercase text-white md:text-6xl">
        Thanks, Cologne!
      </h1>
      <p class="mx-auto mb-4 max-w-2xl text-lg leading-relaxed text-white/90 md:text-xl">
        MAUI Day Cologne 2026 was a wonderful day with the .NET MAUI community.
      </p>
      <p class="mx-auto mb-9 max-w-2xl text-base leading-relaxed text-white/75 md:text-lg">
        We’re already planning our next thing. There’s no event announced just yet, so check back soon
        or follow us on social media to hear about it first.
      </p>

      <div class="mb-10 flex flex-wrap justify-center gap-4">
        <a
          href="/archive/cologne-2026"
          class="btn-gradient rounded-full px-6 py-3 font-bold text-white shadow-lg shadow-pink-500/30 transition hover:-translate-y-0.5"
        >
          Explore the Cologne archive
        </a>
        <a
          href="/gallery"
          class="rounded-full border border-white/30 bg-white/10 px-6 py-3 font-bold text-white backdrop-blur-sm transition hover:bg-white/20"
        >
          Browse the gallery
        </a>
      </div>

      <div class="flex items-center justify-center gap-5 text-xl text-white">
        {socialLinks.map(({ name, href, icon }) => (
          <a
            aria-label={`Follow MAUI Day on ${name}`}
            class="transition hover:-translate-y-0.5 hover:text-pink-300"
            href={href}
            rel="noopener noreferrer"
            target="_blank"
          >
            <i class={`fa-brands ${icon}`}></i>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
